# TERATAI HATI — Environment Variables Configuration
# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase milikmu.

# 1. Supabase Project URL (Dapatkan dari: Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon Public API Key (Dapatkan dari: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key
